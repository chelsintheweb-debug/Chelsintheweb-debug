/* =========================================================
   ENDING MESSAGE
========================================================= */

function getEndingMessage() {

  const happiness =
    player.happiness;

  const money =
    player.money;

  const career =
    player.career;

  const relationships =
    player.relationships;


  if (
    happiness >= 80 &&
    relationships >= 70
  ) {

    return `
      Somehow you managed to accumulate
      happiness AND people who actually like you.
      RobotFriend is impressed.
    `;

  }


  if (
    money >= 6000 &&
    career >= 70
  ) {

    return `
      You optimized aggressively.
      The economy may never recover,
      but your bank account seems fine.
    `;

  }


  if (
    relationships >= 80
  ) {

    return `
      Your greatest achievement wasn't money,
      status, or knowledge.
      It was building a ridiculous network
      of humans who would probably help you
      move seventeen boxes of books.
    `;

  }


  if (
    happiness <= 30
  ) {

    return `
      RobotFriend has detected a concerning
      number of questionable life choices.
      Perhaps next time we invest in sleep.
    `;

  }


  if (
    player.chaos >= 80
  ) {

    return `
      You chose chaos so consistently that
      chaos eventually became a strategy.
      Honestly, impressive.
    `;

  }


  return `
    You didn't exactly follow a plan.

    But then again, nobody really does.

    Your choices created a trajectory,
    and that trajectory became your life.
  `;

}


