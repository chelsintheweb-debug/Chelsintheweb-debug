/* =========================================================
   GAME VARIABLES
========================================================= */

let currentEvent = 0;

let usedEvents = [];


/* =========================================================
   PERSONALITY SELECTION
========================================================= */

function choosePersonality(type, button) {

  player.personality = type;

  document
    .querySelectorAll(".personality")
    .forEach(item => {

      item.classList.remove("selected");

    });

  button.classList.add("selected");

  document.getElementById("startButton").disabled = false;

}


/* =========================================================
   START GAME
========================================================= */

function startGame() {

  const name =
    document
      .getElementById("playerName")
      .value
      .trim();

  player.name =
    name || "RobotFriend";

  applyPersonality();

  document
    .getElementById("characterScreen")
    .classList.add("hidden");

  document
    .getElementById("gameScreen")
    .classList.remove("hidden");

  addLog(
    `${player.name} woke up and entered the simulation.`
  );

  updateStats();

  showEvent();

}


/* =========================================================
   APPLY PERSONALITY
========================================================= */

function applyPersonality() {

  const personality =
    personalities[player.personality];

  if (!personality) return;

  Object.entries(personality.bonuses)
    .forEach(([stat, amount]) => {

      player[stat] += amount;

    });

}


/* =========================================================
   SHOW EVENT
========================================================= */

function showEvent() {

  if (player.day > 15) {

    endGame();

    return;

  }


  /*
    Make sure we don't immediately
    repeat an event.
  */

  let availableEvents =
    events.filter(
      (_, index) =>
        !usedEvents.includes(index)
    );


  /*
    Reset once all events have been used.
  */

  if (availableEvents.length === 0) {

    usedEvents = [];

    availableEvents = [...events];

  }


  const randomIndex =
    Math.floor(
      Math.random() *
      availableEvents.length
    );


  const event =
    availableEvents[randomIndex];


  const actualIndex =
    events.indexOf(event);


  usedEvents.push(actualIndex);

  currentEvent = actualIndex;


  document
    .getElementById("eventCategory")
    .textContent =
    event.category;


  document
    .getElementById("eventTitle")
    .textContent =
    event.title;


  document
    .getElementById("eventDescription")
    .textContent =
    event.description;


  const choices =
    document.getElementById("choices");


  choices.innerHTML = "";


  event.choices.forEach(
    (choice, index) => {

      const button =
        document.createElement("button");


      button.className = "choice";


      button.innerHTML = `

        <span class="choice-title">
          ${choice.title}
        </span>

        <span class="choice-description">
          ${choice.description}
        </span>

      `;


      button.onclick = () =>
        makeChoice(choice, event);


      choices.appendChild(button);

    }
  );

}


/* =========================================================
   MAKE CHOICE
========================================================= */

function makeChoice(choice, event) {

  /*
    Disable buttons immediately so
    one choice cannot be selected twice.
  */

  document
    .querySelectorAll(".choice")
    .forEach(button => {

      button.disabled = true;

    });


  applyEffects(choice.effects);


  addLog(
    `Day ${player.day}: ${event.category} — ${choice.title}`
  );


  /*
    Natural daily changes.
  */

  player.energy -= 3;

  player.day++;


  /*
    Occasionally luck changes
    randomly.
  */

  if (Math.random() < 0.25) {

    const luckChange =
      Math.random() < 0.5
        ? -3
        : 3;

    player.luck += luckChange;

  }


  clampStats();

  updateStats();


  document
    .getElementById("day")
    .textContent =
    player.day;


  setTimeout(
    showEvent,
    350
  );

}


/* =========================================================
   APPLY EFFECTS
========================================================= */

function applyEffects(effects) {

  Object.entries(effects)
    .forEach(([stat, amount]) => {

      if (
        Object.prototype.hasOwnProperty
          .call(player, stat)
      ) {

        player[stat] += amount;

      }

    });

}


/* =========================================================
   KEEP STATS IN RANGE
========================================================= */

function clampStats() {

  const boundedStats = [

    "knowledge",
    "happiness",
    "energy",
    "relationships",
    "career",
    "luck",

    "risk",
    "patience",
    "social",
    "ambition",
    "impulsivity",
    "cooperation",
    "chaos"

  ];


  boundedStats.forEach(stat => {

    player[stat] =
      Math.max(
        0,
        Math.min(
          100,
          player[stat]
        )
      );

  });


  player.money =
    Math.max(
      0,
      player.money
    );

}


/* =========================================================
   UPDATE DISPLAYED STATS
========================================================= */

function updateStats() {

  document
    .getElementById("money")
    .textContent =
    `$${Math.round(player.money).toLocaleString()}`;


  document
    .getElementById("knowledge")
    .textContent =
    Math.round(player.knowledge);


  document
    .getElementById("happiness")
    .textContent =
    Math.round(player.happiness);


  document
    .getElementById("energy")
    .textContent =
    Math.round(player.energy);


  document
    .getElementById("relationships")
    .textContent =
    Math.round(player.relationships);


  document
    .getElementById("career")
    .textContent =
    Math.round(player.career);


  document
    .getElementById("luck")
    .textContent =
    Math.round(player.luck);

}


/* =========================================================
   LIFE LOG
========================================================= */

function addLog(message) {

  const log =
    document.getElementById("log");


  const entry =
    document.createElement("div");


  entry.className =
    "log-entry";


  entry.textContent =
    message;


  log.prepend(entry);


  /*
    Keep the log manageable.
  */

  while (
    log.children.length > 8
  ) {

    log.removeChild(
      log.lastChild
    );

  }

}


/* =========================================================
   CALCULATE FINAL PROFILE
========================================================= */

function calculateProfile() {

  const profiles = {

    strategist:
      player.knowledge +
      player.patience +
      player.career,

    connector:
      player.relationships +
      player.social +
      player.cooperation,

    wild:
      player.risk +
      player.chaos +
      player.impulsivity,

    builder:
      player.career +
      player.ambition +
      player.patience

  };


  return Object
    .entries(profiles)
    .sort(
      (a, b) => b[1] - a[1]
    )[0][0];

}


/* =========================================================
   END GAME
========================================================= */

