let eventIndex = 0;

function startGame() {

  document.getElementById("intro").classList.add("hidden");
  document.getElementById("gameScreen").classList.remove("hidden");

  updateStats();
  showEvent();

}

function showEvent() {

  if (state.day > 12) {
    endGame();
    return;
  }

  const event = events[eventIndex % events.length];

  document.getElementById("eventLabel").textContent = event.label;
  document.getElementById("eventTitle").textContent = event.title;
  document.getElementById("eventDescription").textContent =
    event.description;

  const choices = document.getElementById("choices");

  choices.innerHTML = "";

  event.choices.forEach((choice, index) => {

    const button = document.createElement("button");

    button.className = "choice";

    button.innerHTML = `
      <span class="choice-title">${choice.title}</span>
      <span class="choice-description">${choice.description}</span>
    `;

    button.onclick = () => makeChoice(choice, event);

    choices.appendChild(button);

  });

}

function makeChoice(choice, event) {

  applyEffects(choice.effects);

  addLog(`${event.label}: ${choice.title}`);

  state.day++;

  eventIndex++;

  document.getElementById("day").textContent = state.day;

  updateStats();

  showEvent();

}

function applyEffects(effects) {

  Object.entries(effects).forEach(([key, value]) => {

    if (state[key] !== undefined) {
      state[key] += value;
    }

  });

  clampStats();

}

function clampStats() {

  const stats = [
    "knowledge",
    "happiness",
    "energy",
    "relationships",
    "luck",
    "career",
    "risk",
    "patience",
    "social",
    "ambition",
    "impulsivity",
    "cooperation",
    "chaos"
  ];

  stats.forEach(stat => {

    state[stat] = Math.max(
      0,
      Math.min(100, state[stat])
    );

  });

  state.money = Math.max(0, state.money);

}

function updateStats() {

  document.getElementById("money").textContent =
    `$${Math.round(state.money).toLocaleString()}`;

  document.getElementById("knowledge").textContent =
    Math.round(state.knowledge);

  document.getElementById("happiness").textContent =
    Math.round(state.happiness);

  document.getElementById("energy").textContent =
    Math.round(state.energy);

  document.getElementById("relationships").textContent =
    Math.round(state.relationships);

  document.getElementById("luck").textContent =
    Math.round(state.luck);

  document.getElementById("career").textContent =
    Math.round(state.career);

}

function addLog(message) {

  const log = document.getElementById("logEntries");

  const entry = document.createElement("p");

  entry.textContent = `DAY ${state.day}: ${message}`;

  log.prepend(entry);

}

function getProfile() {

  const scores = {

    "The Strategist":
      state.knowledge +
      state.patience +
      state.career,

    "The Connector":
      state.relationships +
      state.social +
      state.cooperation,

    "The Wild Card":
      state.risk +
      state.chaos +
      state.impulsivity,

    "The Builder":
      state.career +
      state.ambition +
      state.patience,

    "The Explorer":
      state.happiness +
      state.risk +
      state.chaos

  };

  return Object.entries(scores)
    .sort((a, b) => b[1] - a[1])[0][0];

}

function endGame() {

