:root {
  --background: #0b0d12;
  --panel: #151922;
  --panel-2: #1d222d;
  --border: #303746;

  --text: #f5f5f5;
  --muted: #9ca3af;

  --accent: #9b7cff;
  --accent-light: #c4b5fd;

  --green: #67e8a5;
  --red: #fb7185;
  --yellow: #facc15;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;

  min-height: 100vh;

  background:
    radial-gradient(
      circle at top,
      #20243a 0%,
      #0b0d12 55%
    );

  color: var(--text);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.hidden {
  display: none !important;
}


/* =========================
   GAME CONTAINER
========================= */

.game {
  width: min(1100px, 94%);
  margin: auto;

  padding: 35px 0 80px;
}


/* =========================
   HEADER
========================= */

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  margin-bottom: 35px;
}

.tiny {
  color: var(--accent-light);

  font-size: 0.7rem;
  font-weight: 900;

  letter-spacing: 0.18em;

  text-transform: uppercase;
}

h1 {
  margin: 5px 0;

  font-size: clamp(2.4rem, 7vw, 4.5rem);

  line-height: 0.95;
}

.day-box {
  background: var(--panel);

  border: 1px solid var(--border);

  border-radius: 14px;

  padding: 12px 18px;

  text-align: center;
}

.day-box span {
  display: block;

  color: var(--muted);

  font-size: 0.65rem;
  font-weight: 900;

  letter-spacing: 0.15em;
}

.day-box strong {
  display: block;

  margin-top: 2px;

  font-size: 1.5rem;

  color: var(--accent-light);
}


/* =========================
   CHARACTER CREATION
========================= */

.hero {
  text-align: center;

  max-width: 650px;

  margin: 60px auto 30px;
}

.robot {
  font-size: 4rem;

  margin-bottom: 15px;
}

.hero h2 {
  font-size: clamp(2rem, 6vw, 4rem);

  margin: 0;
}

.hero p {
  color: var(--muted);

  font-size: 1.1rem;

  line-height: 1.7;
}

.creation-card {
  max-width: 700px;

  margin: auto;

  background: var(--panel);

  border: 1px solid var(--border);

  border-radius: 24px;

  padding: 35px;
}

.creation-card label {
  display: block;

  margin: 0 0 10px;

  font-size: 0.75rem;

  font-weight: 900;

  text-transform: uppercase;

  letter-spacing: 0.1em;

  color: var(--muted);
}

.creation-card input {
  width: 100%;

  padding: 15px;

  margin-bottom: 30px;

  border-radius: 10px;

  border: 1px solid var(--border);

  background: var(--panel-2);

  color: white;

  outline: none;
}

.creation-card input:focus {
  border-color: var(--accent);
}

.personality-grid {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 12px;

  margin-bottom: 25px;
}

.personality {
  border: 1px solid var(--border);

  border-radius: 14px;

  background: var(--panel-2);

  color: var(--text);

  padding: 20px;

  text-align: left;

  transition: 0.2s;
}

.personality:hover {
  transform: translateY(-2px);

  border-color: var(--accent);
}

.personality.selected {
  border-color: var(--accent);

  background: #29233d;
}

.personality:first-letter {
  font-size: 1.4rem;
}

.personality strong {
  display: block;

  margin: 7px 0 4px;
}

.personality small {
  color: var(--muted);
}

.primary {
  width: 100%;

  border: 0;

  border-radius: 12px;

  padding: 16px;

  background: var(--accent);

  color: white;

  font-weight: 900;

  transition: 0.2s;
}

.primary:hover:not(:disabled) {
  transform: translateY(-2px);

  filter: brightness(1.15);
}

.primary:disabled {
  opacity: 0.35;

  cursor: not-allowed;
}


/* =========================
   STATS
========================= */

.stats {
  display: grid;

  grid-template-columns:
    repeat(7, 1fr);

  gap: 8px;

  margin-bottom: 18px;
}

.stat {
  background: var(--panel);

  border: 1px solid var(--border);

  border-radius: 12px;

  padding: 14px 8px;

  text-align: center;
}

.stat span {
  display: block;

  font-size: 1.25rem;

  margin-bottom: 5px;
}

.stat small {
  display: block;

  color: var(--muted);

  font-size: 0.58rem;

  font-weight: 900;

  letter-spacing: 0.05em;
}

.stat strong {
  display: block;

  margin-top: 5px;

  font-size: 1rem;
}


/* =========================
   EVENT
========================= */

.event {
  background: var(--panel);

  border: 1px solid var(--border);

  border-radius: 22px;

  padding: clamp(28px, 6vw, 60px);

  text-align: center;
}

.event-category {
  color: var(--accent-light);

  font-size: 0.7rem;

  font-weight: 900;

  letter-spacing: 0.18em;
}

.event h2 {
  max-width: 800px;

  margin: 15px auto;

  font-size: clamp(2rem, 5vw, 3.5rem);

  line-height: 1.05;
}

.event > p {
  max-width: 650px;

  margin: auto;

  color: var(--muted);

  font-size: 1.05rem;

  line-height: 1.7;
}


/* =========================
   CHOICES
========================= */

.choices {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 12px;

  margin-top: 35px;
}

.choice {
  background: var(--panel-2);

  border: 1px solid var(--border);

  border-radius: 14px;

  padding: 20px;

  color: var(--text);

  text-align: left;

  transition: 0.2s;
}

.choice:hover {
  border-color: var(--accent);

  transform: translateY(-2px);
}

.choice-title {
  display: block;

  font-weight: 900;

  margin-bottom: 5px;
}

.choice-description {
  color: var(--muted);

  font-size: 0.85rem;

  line-height: 1.5;
}


/* =========================
   LIFE LOG
========================= */

.life-log {
  margin-top: 18px;

  padding: 20px;

  background: var(--panel);

  border: 1px solid var(--border);

  border-radius: 16px;
}

.log-title {
  color: var(--muted);

  font-size: 0.7rem;

  font-weight: 900;

  letter-spacing: 0.1em;
}

#log {
  margin-top: 10px;
}

.log-entry {
  color: var(--muted);

  font-size: 0.85rem;

  padding: 7px 0;

  border-bottom: 1px solid #242936;
}


/* =========================
   ENDING
========================= */

.ending {
  max-width: 800px;

  margin: 70px auto;

  text-align: center;
}

.ending h2 {
  font-size: clamp(2.5rem, 7vw, 5rem);

  margin: 10px 0;
}

.ending > p {
  color: var(--muted);

  line-height: 1.7;

  font-size: 1.1rem;
}

.final-stats {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 10px;

  margin: 35px 0;
}

.final-stat {
  background: var(--panel);

  border: 1px solid var(--border);

  border-radius: 14px;

  padding: 20px;
}

.final-stat small {
  display: block;

  color: var(--muted);

  font-size: 0.65rem;

  font-weight: 900;

  letter-spacing: 0.08em;
}

.final-stat strong {
  display: block;

  margin-top: 5px;

  font-size: 1.4rem;
}

.personality-result {
  margin: 25px 0;

  padding: 30px;

  background: var(--panel);

  border: 1px solid var(--border);

  border-radius: 18px;
}

.personality-result h3 {
  font-size: 2rem;

  margin: 10px 0;
}

.personality-result p {
  color: var(--muted);

  line-height: 1.7;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

  .stats {
    grid-template-columns:
      repeat(4, 1fr);
  }

}

@media (max-width: 600px) {

  .game {
    width: 92%;

    padding-top: 25px;
  }

  .personality-grid {
    grid-template-columns: 1fr;
  }

  .choices {
    grid-template-columns: 1fr;
  }

  .stats {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .final-stats {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .topbar {
    align-items: center;
  }

}
