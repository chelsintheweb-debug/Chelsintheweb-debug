:root {
  --bg: #0d0f14;
  --panel: #171a22;
  --panel-light: #202530;
  --text: #f4f4f5;
  --muted: #9ca3af;
  --accent: #8b5cf6;
  --accent-light: #a78bfa;
  --border: #303542;
  --success: #4ade80;
  --danger: #fb7185;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, #1d2030 0%, var(--bg) 55%);
  color: var(--text);
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button {
  font: inherit;
}

.game {
  width: min(1100px, 92%);
  margin: auto;
  padding: 50px 0 80px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 45px;
}

.eyebrow {
  color: var(--accent-light);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  margin-bottom: 10px;
}

h1 {
  font-size: clamp(2.8rem, 7vw, 5rem);
  line-height: 0.95;
  margin: 0;
}

.tagline {
  color: var(--muted);
  font-size: 1.1rem;
}

.day {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 18px;
  font-weight: 800;
  white-space: nowrap;
}

.day span {
  color: var(--accent-light);
}

.intro {
  max-width: 650px;
  margin: 80px auto;
  text-align: center;
}

.intro h2 {
  font-size: clamp(2rem, 6vw, 4.5rem);
  margin: 0;
  line-height: 1;
}

.intro p {
  color: var(--muted);
  font-size: 1.2rem;
  margin: 25px 0 35px;
}

button {
  border: 0;
  border-radius: 12px;
  padding: 15px 25px;
  background: var(--accent);
  color: white;
  cursor: pointer;
  font-weight: 800;
  transition:
    transform 0.15s ease,
    filter 0.15s ease;
}

button:hover {
  transform: translateY(-2px);
  filter: brightness(1.12);
}

.hidden {
  display: none !important;
}

.stats {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10px;
  margin-bottom: 25px;
}

.stat {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 15px 10px;
  text-align: center;
}

.stat span {
  display: block;
  font-size: 1.5rem;
  margin-bottom: 7px;
}

.stat label {
  display: block;
  color: var(--muted);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.stat strong {
  display: block;
  margin-top: 5px;
  font-size: 1rem;
}

.event-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: clamp(25px, 5vw, 55px);
  text-align: center;
}

.event-label {
  color: var(--accent-light);
  font-size: 0.75rem;
  font-weight: 900;
  letter-spacing: 0.15em;
}

.event-card h2 {
  font-size: clamp(2rem, 5vw, 3.5rem);
  margin: 15px auto;
  max-width: 750px;
}

.event-card > p:not(.event-label) {
  max-width: 650px;
  margin: auto;
  color: var(--muted);
  line-height: 1.7;
  font-size: 1.1rem;
}

.choices {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-top: 35px;
}

.choice {
  background: var(--panel-light);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 20px;
  text-align: left;
  border-radius: 14px;
}

.choice:hover {
  border-color: var(--accent);
  background: #272b38;
}

.choice-title {
  font-weight: 900;
  display: block;
  margin-bottom: 5px;
}

.choice-description {
  color: var(--muted);
  font-size: 0.85rem;
}

.log {
  margin-top: 25px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 25px;
}

.log h3 {
  margin-top: 0;
}

#logEntries {
  color: var(--muted);
  font-size: 0.9rem;
}

#logEntries p {
  margin: 8px 0;
}

.ending {
  max-width: 750px;
  margin: 80px auto;
  text-align: center;
}

.ending h2 {
  font-size: clamp(2.5rem, 7vw, 5rem);
  margin: 10px 0;
}

#endingText {
  color: var(--muted);
  font-size: 1.15rem;
  line-height: 1.7;
}

.final-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 35px 0;
}

.final-stat {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 20px;
}

.final-stat small {
  display: block;
  color: var(--muted);
  text-transform: uppercase;
  font-size: 0.7rem;
}

.final-stat strong {
  display: block;
  font-size: 1.5rem;
  margin-top: 5px;
}

@media (max-width: 850px) {

  .stats {
    grid-template-columns: repeat(4, 1fr);
  }

}

@media (max-width: 600px) {

  .game {
    padding-top: 30px;
  }

  .header {
    flex-direction: column;
  }

  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .choices {
    grid-template-columns: 1fr;
  }

  .final-stats {
    grid-template-columns: repeat(2, 1fr);
  }

}
